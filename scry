#!/usr/bin/env bash
# Minimum: Python 3.10 or newer.
# The first run also needs a network connection. scry creates .venv,
# installs dependencies, and downloads Stable Diffusion 2.1.
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
venv_python="$root/.venv/bin/python"

python_ok() {
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'
}

base_python() {
  local candidate resolved
  for candidate in /opt/homebrew/bin/python3.12 python3.12 python3.13 python3.11 python3.10 python3; do
    if [[ "$candidate" == /* ]]; then
      [[ -x "$candidate" ]] || continue
      resolved="$candidate"
    else
      command -v "$candidate" >/dev/null 2>&1 || continue
      resolved="$(command -v "$candidate")"
    fi
    if python_ok "$resolved"; then
      echo "$resolved"
      return
    fi
  done
  cat >&2 <<'EOF'
scry needs Python 3.10 or newer.
The first run also needs a network connection: scry creates .venv,
installs dependencies, and downloads Stable Diffusion 2.1.
EOF
  exit 1
}

deps_ready() {
  "$1" -c 'import importlib.util, sys
need = ("torch", "diffusers", "PIL", "huggingface_hub")
sys.exit(0 if all(importlib.util.find_spec(name) for name in need) else 1)'
}

if [[ ! -x "$venv_python" ]] || ! deps_ready "$venv_python"; then
  if [[ ! -x "$venv_python" ]]; then
    "$(base_python)" -m venv "$root/.venv"
  fi
  PIP_DISABLE_PIP_VERSION_CHECK=1 "$root/.venv/bin/python" -m pip install --upgrade pip
  PIP_DISABLE_PIP_VERSION_CHECK=1 "$root/.venv/bin/python" -m pip install -r "$root/requirements.txt"
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
export DIFFUSERS_VERBOSITY=error
export TRANSFORMERS_VERBOSITY=error
export TOKENIZERS_PARALLELISM=false
exec "$venv_python" -m src "$@"
